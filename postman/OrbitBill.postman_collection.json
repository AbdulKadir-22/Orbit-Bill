{
  "info": {
    "_postman_id": "a4d3f281-9b7e-46ea-b2e1-orbitbill001",
    "name": "OrbitBill Complete API Suite",
    "description": "Comprehensive Postman collection for OrbitBill Subscription & Invoicing Engine, covering Auth, Catalog, Subscriptions, Invoices, Payments, Reports, Dashboard, and Customer Portal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" },
    { "key": "createdCustomerId", "value": "", "type": "string" },
    { "key": "createdProductId", "value": "", "type": "string" },
    { "key": "createdPlanId", "value": "", "type": "string" },
    { "key": "createdTaxId", "value": "", "type": "string" },
    { "key": "createdDiscountId", "value": "", "type": "string" },
    { "key": "createdSubscriptionId", "value": "", "type": "string" },
    { "key": "createdInvoiceId", "value": "", "type": "string" },
    { "key": "createdPaymentId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('adminToken', json.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@orbitbill.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Customer Portal Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('customerToken', json.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"billing@acme.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "02. Dashboard",
      "item": [
        {
          "name": "Get Dashboard Metrics (Admin/Staff)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard", "host": ["{{baseUrl}}"], "path": ["dashboard"] }
          }
        }
      ]
    },
    {
      "name": "03. Invoices",
      "item": [
        {
          "name": "List Invoices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/invoices?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Draft Invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "  pm.collectionVariables.set('createdInvoiceId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{createdCustomerId}}\",\n  \"invoiceDate\": \"2026-10-31T00:00:00.000Z\",\n  \"dueDate\": \"2026-11-15T00:00:00.000Z\",\n  \"lines\": [\n    {\n      \"productName\": \"Enterprise Addon\",\n      \"quantity\": 1,\n      \"unitPrice\": 1500,\n      \"taxRate\": 18\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/invoices", "host": ["{{baseUrl}}"], "path": ["invoices"] }
          }
        },
        {
          "name": "Confirm Invoice",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{createdInvoiceId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["invoices", "{{createdInvoiceId}}", "confirm"]
            }
          }
        },
        {
          "name": "Stream Invoice PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{createdInvoiceId}}/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["invoices", "{{createdInvoiceId}}", "pdf"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Payments",
      "item": [
        {
          "name": "Record Payment (Partial)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "  pm.collectionVariables.set('createdPaymentId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceId\": \"{{createdInvoiceId}}\",\n  \"amount\": 500,\n  \"method\": \"bank_transfer\",\n  \"reference\": \"RTGS-POSTMAN-001\",\n  \"notes\": \"Test partial collection via Postman\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "Void Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Duplicate payment recorded in error\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/{{createdPaymentId}}/void",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "{{createdPaymentId}}", "void"]
            }
          }
        }
      ]
    },
    {
      "name": "05. Financial Reports",
      "item": [
        {
          "name": "Revenue by Method and Timeline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/reports/revenue", "host": ["{{baseUrl}}"], "path": ["reports", "revenue"] }
          }
        },
        {
          "name": "Invoices Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/reports/invoices-summary",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "invoices-summary"]
            }
          }
        },
        {
          "name": "Overdue Invoices & Aging Buckets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/reports/overdue", "host": ["{{baseUrl}}"], "path": ["reports", "overdue"] }
          }
        },
        {
          "name": "Subscriptions & Normalized MRR",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/reports/subscriptions",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "subscriptions"]
            }
          }
        },
        {
          "name": "Export Report to CSV Stream",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/reports/export?reportType=revenue",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "export"],
              "query": [{ "key": "reportType", "value": "revenue" }]
            }
          }
        }
      ]
    },
    {
      "name": "06. Customer Portal",
      "item": [
        {
          "name": "Portal Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/portal/dashboard", "host": ["{{baseUrl}}"], "path": ["portal", "dashboard"] }
          }
        },
        {
          "name": "Portal Subscriptions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/portal/subscriptions",
              "host": ["{{baseUrl}}"],
              "path": ["portal", "subscriptions"]
            }
          }
        },
        {
          "name": "Portal Invoices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/portal/invoices", "host": ["{{baseUrl}}"], "path": ["portal", "invoices"] }
          }
        },
        {
          "name": "Portal Download Invoice PDF",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/portal/invoices/{{createdInvoiceId}}/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["portal", "invoices", "{{createdInvoiceId}}", "pdf"]
            }
          }
        },
        {
          "name": "Portal Payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/portal/payments", "host": ["{{baseUrl}}"], "path": ["portal", "payments"] }
          }
        }
      ]
    },
    {
      "name": "07. Admin Automated Jobs Trigger",
      "item": [
        {
          "name": "Manual Run Billing Engine Cycle",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/jobs/billing/run",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "jobs", "billing", "run"]
            }
          }
        }
      ]
    }
  ]
}
