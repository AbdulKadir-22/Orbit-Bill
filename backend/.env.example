NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/orbitbill_db

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_16_chars
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=10

# Password Reset
RESET_PASSWORD_EXPIRES_MIN=15
RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Email Service (Resend)
RESEND_API_KEY=
EMAIL_FROM=OrbitBill <noreply@orbitbill.com>

# Super Admin Initial Seeding
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@orbitbill.com
SEED_ADMIN_PASSWORD=Admin@12345

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Subscription & Billing Configuration
DEFAULT_PAYMENT_TERMS_DAYS=15
SUBSCRIPTION_CRON_SCHEDULE=30 0 * * *
BILLING_CRON_SCHEDULE=0 1 * * *
BILLING_AUTO_CONFIRM=true
BILLING_BATCH_SIZE=100
BILLING_MAX_CATCHUP_PERIODS=3
DASHBOARD_CACHE_TTL_SEC=60
OVERDUE_REMINDER_ENABLED=false
DEFAULT_CURRENCY=INR

# Organization / Company Profile (for PDFs & Invoices)
COMPANY_NAME=OrbitBill Inc.
COMPANY_ADDRESS=123 Enterprise Way, Tech City, KA, 560001, India
COMPANY_GSTIN=29AAAAA0000A1Z5
COMPANY_EMAIL=billing@orbitbill.com

# API Documentation
SWAGGER_ENABLED=true
